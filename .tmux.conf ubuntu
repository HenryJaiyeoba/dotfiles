##### Reload config #####
unbind r
bind r source-file ~/.tmux.conf \; display-message "Reloaded ~/.tmux.conf"

##### Terminal / colors #####
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"

##### Prefix #####
unbind C-b
set -g prefix C-s
bind C-s send-prefix

##### Basics #####
set -g mouse on
setw -g mode-keys vi

##### Pane navigation #####
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

##### Split shortcut #####
bind - split-window -v -l 6 -c "#{pane_current_path}"
bind-key _ kill-pane

##### Appearance #####
set -g status on 
set -g status-position top
set -g status-style bg=default,fg=#c0c0c0
set -g pane-border-style fg=#4a4a4a
set -g pane-active-border-style fg=#7c7c7c
set -g display-panes-colour #444444
set -g display-panes-active-colour #666666
set -g window-style bg=default
set -g window-active-style bg=default

##### Naming #####
set -g allow-rename off
set -g automatic-rename on
set -g automatic-rename-format '#{b:pane_current_path}'

##### Plugins #####
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
set -g @resurrect-save 'S'
set -g @resurrect-restore 'R'

##### TPM must be last #####
run '~/.tmux/plugins/tpm/tpm'
